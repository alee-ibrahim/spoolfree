{
  "name": "spoolfree",
  "version": "0.7.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "keygen": "node --env-file-if-exists=.env --import tsx scripts/keygen.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "printers": "node --env-file-if-exists=.env --import tsx scripts/printers.ts",
    "build:cli": "esbuild scripts/cli.ts --bundle --platform=node --format=esm --target=node24 --outfile=cli/spoolfree-cli.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "local-user": "node --env-file-if-exists=.env --import tsx scripts/local-user.ts",
    "seed:dev": "node --env-file-if-exists=.env --import tsx scripts/seed-dev.ts",
    "screenshots": "node --env-file-if-exists=.env --import tsx scripts/screenshots.ts",
    "check:ou-picker": "node --import tsx scripts/ou-picker-check.ts",
    "dev:printers": "node --import tsx scripts/fake-printers.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "ldapts": "^9.2.0",
    "lucide-react": "^1.68.0",
    "net-snmp": "^3.29.2",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.15.0",
  "license": "MIT",
  "description": "Driverless IPP printer management for Windows Active Directory"
}
