# Spoolfree configuration. Copy to .env for local development.
# Every variable is optional unless marked REQUIRED (production).
# Secrets can also be given as files: MANIFEST_SIGNING_KEY_FILE, AGENT_ENROLLMENT_TOKEN_FILE.

# --- Core -------------------------------------------------------------------
# REQUIRED. PostgreSQL connection string.
DATABASE_URL=postgres://spoolfree:spoolfree@localhost:55432/spoolfree
# REQUIRED. External URL of the app (used for links and shown in the agent install command).
PUBLIC_URL=http://localhost:3000
# Apply database migrations at startup (default 1).
MIGRATE_ON_START=1

# --- Admin login: Microsoft Entra ID (OIDC via Auth.js) -----------------------
# REQUIRED. Random 32+ byte secret for session encryption: `openssl rand -base64 32`.
AUTH_SECRET=
# REQUIRED. App registration client ID / secret.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# REQUIRED. https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
# Go straight to Entra from the login page (default: on when Entra is configured and DEV_LOGIN is off).
# /login?local=1 and /login?signedout=1 always show the page. See docs/admin-access.md.
# AUTH_AUTO_SIGNIN=true
# Break-glass local admin accounts for when Entra is down (OFF by default). Create them with
# `npx tsx scripts/local-user.ts add <username>`; sign in at /login?local=1. See SECURITY.md.
LOCAL_LOGIN_ENABLED=false
# Lockout after this many wrong passwords, for this many minutes; attempts per client IP per 15 minutes.
LOCAL_LOGIN_MAX_FAILURES=5
LOCAL_LOGIN_LOCKOUT_MINUTES=15
LOCAL_LOGIN_IP_MAX_ATTEMPTS=20
# Who may sign in to the admin UI (docs/admin-access.md):
#   group             (default) members of ADMIN_GROUP_IDS, read from the ID token's groups claim.
#   entra-assignment  every user the single-tenant Entra app lets sign in. "Assignment required"
#                     MUST be switched on for the enterprise app, and you control access by assigning
#                     users (or groups) to it. The token's tenant (tid) and issuer must match
#                     AUTH_MICROSOFT_ENTRA_ID_ISSUER; a common/organizations issuer is refused.
# Production builds refuse to start in group mode with an empty ADMIN_GROUP_IDS.
ADMIN_ACCESS_MODE=group
# REQUIRED in group mode. Comma-separated Entra group object IDs whose members may sign in.
ADMIN_GROUP_IDS=00000000-0000-0000-0000-000000000000

# --- Active Directory (read-only LDAP bind) ---------------------------------
# Where directory data comes from:
#   ldap      (default) the app binds to LDAP(S) itself with LDAP_BIND_DN / LDAP_BIND_PASSWORD.
#   snapshot  the AD sync sidecar (adsync/, image spoolfree-adsync) binds with Kerberos and pushes
#             snapshots to POST /api/internal/directory-snapshot; see docs/deployment.md.
DIRECTORY_MODE=ldap
# snapshot mode: shared bearer token for the sidecar (32+ random characters). Unset = endpoint refuses all.
DIRECTORY_SYNC_TOKEN=
# DIRECTORY_SYNC_TOKEN_FILE=/run/secrets/directory-sync-token
# snapshot mode: the UI warns when the last snapshot is older than this (minutes).
DIRECTORY_STALE_MINUTES=30
# snapshot mode: agents are refused (503) when the last snapshot is older than this (hours; 0 = never).
DIRECTORY_MAX_AGE_HOURS=24
# LDAP_BASE_DN is used in both modes (snapshot mode rejects snapshots of another base DN).
LDAP_URL=ldaps://dc1.example.org:636
LDAP_BIND_DN=CN=svc-spoolfree,OU=Service Accounts,DC=example,DC=org
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=example,DC=org
# PEM file with your AD CS root/issuing CA, for validating the DC's LDAPS certificate.
LDAP_CA_CERT_FILE=
# Set to 0 only for testing; never in production.
LDAP_TLS_REJECT_UNAUTHORIZED=1
# Cache for OU and computer lists (seconds). Agent authentication always queries live.
LDAP_CACHE_SECONDS=300

# --- Agent ------------------------------------------------------------------
# REQUIRED. Generate both with `pnpm keygen`.
# Base64 32-byte Ed25519 seed used to sign manifests.
MANIFEST_SIGNING_KEY=
# MANIFEST_SIGNING_KEY_FILE=/run/secrets/manifest-signing-key
# Shared enrollment token (also written to the restricted share read by the GPO script).
AGENT_ENROLLMENT_TOKEN=
# AGENT_ENROLLMENT_TOKEN_FILE=/run/secrets/enrollment-token
# Manifest validity; agents reject expired manifests (replay protection).
MANIFEST_TTL_HOURS=24
# Agents without a report for this long show as stale.
AGENT_STALE_HOURS=26

# --- Status poller ----------------------------------------------------------
POLLER_ENABLED=1
POLL_INTERVAL_SECONDS=120
POLL_TIMEOUT_MS=5000
POLL_CONCURRENCY=8
# SNMP v2c community for the Printer-MIB fallback.
SNMP_COMMUNITY=public
LOW_TONER_PERCENT=15
# Optional: POST a JSON alert here when a printer goes offline / jams / runs low (and when it recovers).
ALERT_WEBHOOK_URL=

# --- Legacy print servers ---------------------------------------------------
# Print servers whose \\server\share connections agents may replace (per-printer "Replace existing
# queues for this device"; see docs/agent.md). FQDN or short name, comma-separated.
LEGACY_PRINT_SERVERS=

# --- Metrics ----------------------------------------------------------------
# Optional bearer token required to scrape /metrics.
METRICS_TOKEN=

# --- Development only (ignored by production builds) ------------------------
# Use the built-in sample directory (example.org) instead of LDAP.
DEV_FAKE_AD=0
# Optional: JSON file (kept outside the repo) that replaces the sample directory,
# so a real test PC can enroll. Format documented in src/lib/directory/fake.ts.
# DEV_FAKE_AD_FILE=
# Show a "Development login" button that skips Entra ID.
DEV_LOGIN=0
